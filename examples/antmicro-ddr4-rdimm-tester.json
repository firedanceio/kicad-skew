{
 "_comment": "Antmicro data-center-dram-tester (github.com/antmicro/data-center-dram-tester), DDR4 x4 RDIMM, 72 bits. DQ nibbles held to 1 mm of their strobe (DQS0-8 lower nibbles, DQS9-17 upper), command/address to 1 mm of CK0, pairs to 12 mil. Example limits: check your FPGA's memory guide.",
 "measure": [
  "DQ*",
  "CB*",
  "CK0_*",
  "CK1_*",
  "A*",
  "BA*",
  "BG*",
  "PARITY",
  "CKE0",
  "ODT0",
  "~{ACT}",
  "~{CS0}"
 ],
 "exclude": [
  "AUX*",
  "AV*"
 ],
 "rules": [
  {
   "type": "pairs",
   "label": "P/N",
   "match": "^(CK[01]|DQS\\d+)_P$",
   "p": "_P",
   "n": "_N",
   "max": 0.3048
  },
  {
   "type": "group",
   "label": "DQS0",
   "members": [
    "^DQ(0|1|2|3)$"
   ],
   "reference": [
    "^DQS0_[PN]$"
   ],
   "max": 1.0
  },
  {
   "type": "group",
   "label": "DQS9",
   "members": [
    "^DQ(4|5|6|7)$"
   ],
   "reference": [
    "^DQS9_[PN]$"
   ],
   "max": 1.0
  },
  {
   "type": "group",
   "label": "DQS1",
   "members": [
    "^DQ(8|9|10|11)$"
   ],
   "reference": [
    "^DQS1_[PN]$"
   ],
   "max": 1.0
  },
  {
   "type": "group",
   "label": "DQS10",
   "members": [
    "^DQ(12|13|14|15)$"
   ],
   "reference": [
    "^DQS10_[PN]$"
   ],
   "max": 1.0
  },
  {
   "type": "group",
   "label": "DQS2",
   "members": [
    "^DQ(16|17|18|19)$"
   ],
   "reference": [
    "^DQS2_[PN]$"
   ],
   "max": 1.0
  },
  {
